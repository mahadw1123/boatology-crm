# Boatology CRM environment configuration
# Copy this file to a new file named .env before running the CRM.
# Never commit the real .env file or share production secrets.

# Application
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:5173

# Local SQLite database
DATABASE_URL=./data/boatology.db

# Optional: use one persistent directory for the database, uploads, and backups
# Useful on hosting services with an attached persistent disk.
PERSISTENT_DATA_DIR=

# Security
# Generate each value separately with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret
INTEGRATION_ENCRYPTION_KEY=replace-with-a-different-long-random-secret

# Email through Resend
# Leave blank for local development if you do not need real email delivery.
RESEND_API_KEY=
EMAIL_FROM=Boatology <onboarding@resend.dev>

# Stripe test-mode payments
# Configure all three together before testing payments.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Xero integration (optional)
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
XERO_REDIRECT_URI=http://localhost:4000/api/xero/callback

# Google review discount (optional)
GOOGLE_REVIEW_URL=
REVIEW_DISCOUNT_AMOUNT=50

# Receipt OCR (optional)
ANTHROPIC_API_KEY=

# Scheduled jobs and morning briefing timezone
SCHEDULER_TIMEZONE=Australia/Sydney

# Optional: store automatic backups in a separate/cloud-synced directory.
# Example Windows: BACKUP_DIR=C:\\Users\\YourName\\OneDrive\\Boatology Backups
# Example Linux host: BACKUP_DIR=/mnt/boatology-backups
BACKUP_DIR=
